# LiteLLM + Ollama defaults for CPU-only workstations. See docs/runbook-ollama.md § 8.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=ollama/qwen2.5:7b
# Optional override when routing LiteLLM through a custom gateway/proxy
LITELLM_API_BASE=
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT=180
OLLAMA_NUM_PREDICT=6144
OLLAMA_FALLBACK_ON_ERROR=true
# Optional cloud-provider credentials for non-Ollama models
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LOG_LEVEL=INFO
PROFILER_MODE=auto
